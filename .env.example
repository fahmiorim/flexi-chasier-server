# Salin file ini menjadi .env lalu sesuaikan nilainya
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flexi_chasier?schema=public"

JWT_ACCESS_SECRET="ganti-dengan-secret-panjang-acak"
JWT_REFRESH_SECRET="ganti-dengan-secret-panjang-acak-lain"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

PORT=4000

# Verifikasi email (Resend). Kosongkan untuk mode dev: kode ditampilkan di log server.
RESEND_API_KEY=""
EMAIL_DARI="Flexi Kasir <noreply@flexikasir.test>"
